.env
.env.*
!.env.example

# ---------- Node / 包管理器 ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ---------- 构建产物 ----------
dist/
dist-ssr/
build/
out/
*.local
*.tsbuildinfo

# ---------- Electron 打包产物 ----------
release/
apps/desktop/dist-electron/

# ---------- 测试与覆盖率 ----------
coverage/
.vitest/
test-results/
playwright-report/

# ---------- 缓存 ----------
.cache/
.turbo/
.eslintcache
.vite/

# ---------- 日志 ----------
logs/
*.log

# ---------- 数据库本地数据与备份 ----------
