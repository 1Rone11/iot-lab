# FieldLab IoT 环境变量示例
# 使用方式：cp .env.example .env，然后按本机情况修改
# 规则：真实密钥只放 .env 或部署平台的 Secret，绝不提交、不写进代码与日志

# ---------- 通用 ----------
# 运行环境：development | test | production
NODE_ENV=development

# ---------- API 服务端 (apps/api) ----------
# 监听端口，仅本机开发使用
API_PORT=3000

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# ---------- PostgreSQL ----------
# 本地 Docker Compose 起的库；生产环境使用独立强密码并由部署平台注入
DATABASE_URL=postgresql://fieldlab:change-me-locally@localhost:5432/fieldlab
# 集成测试专用库，测试会清空此库，禁止指向开发库
TEST_DATABASE_URL=postgresql://fieldlab:change-me-locally@localhost:5432/fieldlab_test

# ---------- MQTT ----------
# Broker 只在内部网络可达；生产环境不映射公网端口
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=fieldlab/v1

# ---------- 共享客户端 (apps/client) ----------
# Web 目标：开发时由 Vite 代理到 API，保持同源 /api 语义
VITE_API_BASE_URL=/api
# Electron 目标：页面走 file://，不能用相对路径，由 preload 提供公开服务地址（非密钥）
VITE_DESKTOP_API_BASE_URL=http://localhost:3000/api
